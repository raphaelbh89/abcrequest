generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  role         String   @default("teacher") // enum('admin','manager','stocker','teacher')
  createdAt    DateTime @default(now()) @map("created_at")

  requests               Request[]          @relation("UserRequests")
  decidedRequests        Request[]          @relation("DecidedRequests")
  stockTransactions      StockTransaction[] @relation("UserStockTransactions")
  receivedDisbursements  Disbursement[]     @relation("RecipientDisbursements")
  createdDisbursements   Disbursement[]     @relation("DisbursedByDisbursements")
  createdReturns         ReuseReturn[]      @relation("ReturnerReuseReturns")
  receivedReturns        ReuseReturn[]      @relation("ReceivedByReuseReturns")

  @@map("users")
}

model Item {
  id             String   @id @default(uuid())
  name           String
  category       String   // code của category, vd 'hoc_tap', 'ngoai_khoa', ...
  unit           String   // cái, hộp, cuộn, gói, mét, ram, bộ...
  quantity       Int      // tồn kho hiện tại (số thật)
  minStock       Int      @map("min_stock") // ngưỡng cảnh báo sắp hết
  price          Float?   // đơn giá tham khảo
  location       String?
  imageUrl       String?  @map("image_url")
  nameNormalized String?  @default("") @map("name_normalized")
  embedding      String?  @map("embedding") // Vector/Embedding JSON or string
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  requestItems      RequestItem[]
  purchaseProposals PurchaseProposal[]
  stockTransactions StockTransaction[]
  disbursementItems DisbursementItem[]
  reuseReturns      ReuseReturn[]

  @@index([nameNormalized])
  @@map("items")
}

model Request {
  id                 String    @id @default(uuid())
  requesterId        String    @map("requester_id")
  requester          User      @relation("UserRequests", fields: [requesterId], references: [id])
  purpose            String    // chủ đề / hoạt động, vd "Trang trí góc Mùa xuân"
  neededDate         DateTime  @map("needed_date")
  note               String?
  status             String    @default("pending") // enum('pending','approved','rejected')
  disbursementStatus String    @default("cho_cap_phat") @map("disbursement_status") // enum('cho_cap_phat','da_cap_phat','cap_phat_mot_phan')
  createdAt          DateTime  @default(now()) @map("created_at")
  decidedAt          DateTime? @map("decided_at")
  decidedBy          String?   @map("decided_by")
  decidedByUser      User?     @relation("DecidedRequests", fields: [decidedBy], references: [id])
  rejectReason       String?   @map("reject_reason")

  themeId            String?   @map("theme_id")
  theme              EventTheme? @relation(fields: [themeId], references: [id])
  requestItems      RequestItem[]
  purchaseProposals PurchaseProposal[]
  disbursements     Disbursement[]

  @@map("requests")
}

model EventTheme {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  icon        String?   @default("🎯")
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  requests    Request[]

  @@map("event_themes")
}

model RequestItem {
  id                String   @id @default(uuid())
  requestId         String   @map("request_id")
  request           Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  itemId            String?  @map("item_id")
  item              Item?    @relation(fields: [itemId], references: [id])
  requestedQty      Int      @map("requested_qty") // số lượng giáo viên xin
  allocatedQty      Int      @map("allocated_qty") // số được cấp từ kho (tính ngay khi tạo yêu cầu)
  shortfallQty      Int      @map("shortfall_qty") // số còn thiếu = requested_qty - allocated_qty
  status            String   @default("approved")  // 'approved' | 'rejected'
  isNewItemProposal Boolean  @default(false) @map("is_new_item_proposal")
  proposedName      String?  @map("proposed_name")
  proposedUnit      String?  @map("proposed_unit")
  proposedPrice     Float?   @map("proposed_price")
  proposedImageUrl  String?  @map("proposed_image_url")
  proposedSourceUrl String?  @map("proposed_source_url")

  @@map("request_items")
}

model PurchaseProposal {
  id              String    @id @default(uuid())
  itemId          String?   @map("item_id")
  item            Item?     @relation(fields: [itemId], references: [id])
  proposedName    String?   @map("proposed_name")
  proposedUnit    String?   @map("proposed_unit")
  qty             Int
  sourceRequestId String    @map("source_request_id")
  sourceRequest   Request   @relation(fields: [sourceRequestId], references: [id])
  status          String    @default("can_mua") // enum('can_mua','da_dat_mua','da_nhap_kho')
  createdAt       DateTime  @default(now()) @map("created_at")
  receivedQty     Int       @default(0) @map("received_qty")
  resolvedAt      DateTime? @map("resolved_at")

  @@map("purchase_proposals")
}

model StockTransaction {
  id             String   @id @default(uuid())
  itemId         String   @map("item_id")
  item           Item     @relation(fields: [itemId], references: [id])
  type           String   // enum('nhap_kho','xuat_kho_duyet_yc','xuat_kho_cap_phat','nhap_tai_su_dung','dieu_chinh')
  quantityChange Int      @map("quantity_change") // có thể âm hoặc dương
  referenceId    String?  @map("reference_id") // request_id, disbursement_id hoặc reuse_return_id liên quan
  performedBy    String   @map("performed_by")
  performedUser  User     @relation("UserStockTransactions", fields: [performedBy], references: [id])
  createdAt      DateTime @default(now()) @map("created_at")
  note           String?

  @@map("stock_transactions")
}

model Disbursement {
  id            String             @id @default(uuid())
  code          String             @unique // Mã phiếu cấp phát, vd: CP-20260821-001
  requestId     String             @map("request_id")
  request       Request            @relation(fields: [requestId], references: [id])
  recipientId   String             @map("recipient_id")
  recipient     User               @relation("RecipientDisbursements", fields: [recipientId], references: [id])
  disbursedBy   String             @map("disbursed_by")
  disbursedUser User               @relation("DisbursedByDisbursements", fields: [disbursedBy], references: [id])
  disbursedAt   DateTime           @default(now()) @map("disbursed_at")
  status        String             @default("completed") // enum('completed','partial')
  note          String?
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  items        DisbursementItem[]
  reuseReturns ReuseReturn[]

  @@map("disbursements")
}

model DisbursementItem {
  id             String       @id @default(uuid())
  disbursementId String       @map("disbursement_id")
  disbursement   Disbursement @relation(fields: [disbursementId], references: [id], onDelete: Cascade)
  itemId         String?      @map("item_id")
  item           Item?        @relation(fields: [itemId], references: [id])
  itemName       String       @map("item_name")
  itemUnit       String       @map("item_unit")
  disbursedQty   Int          @map("disbursed_qty")
  returnedQty    Int          @default(0) @map("returned_qty")
  isReusable     Boolean      @default(true) @map("is_reusable")

  @@map("disbursement_items")
}

model ReuseReturn {
  id               String        @id @default(uuid())
  code             String        @unique // Mã phiếu tái sử dụng, vd: TSD-20260821-001
  disbursementId   String?       @map("disbursement_id")
  disbursement     Disbursement? @relation(fields: [disbursementId], references: [id])
  itemId           String        @map("item_id")
  item             Item          @relation(fields: [itemId], references: [id])
  returnedQty      Int           @map("returned_qty")
  condition        String        @default("tot") // enum('tot','kha','trung_binh')
  returnerId       String?       @map("returner_id")
  returnerUser     User?         @relation("ReturnerReuseReturns", fields: [returnerId], references: [id])
  returnerName     String?       @map("returner_name") // Tên giáo viên / Lớp học
  receivedBy       String        @map("received_by")
  receivedUser     User          @relation("ReceivedByReuseReturns", fields: [receivedBy], references: [id])
  returnedAt       DateTime      @default(now()) @map("returned_at")
  estimatedSavings Float?        @map("estimated_savings")
  note             String?
  createdAt        DateTime      @default(now()) @map("created_at")

  @@map("reuse_returns")
}

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model Category {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  color       String   @default("emerald") // 'emerald', 'sky', 'purple', 'amber', 'rose', 'indigo'
  isDefault   Boolean  @default(false) @map("is_default")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("categories")
}

model ExternalSearchCache {
  id              String   @id @default(uuid())
  queryNormalized String   @unique @map("query_normalized")
  resultsJson     String   @map("results_json")
  createdAt       DateTime @default(now()) @map("created_at")
  expiresAt       DateTime @map("expires_at")

  @@index([queryNormalized])
  @@map("external_search_cache")
}

model UserApiUsage {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  endpoint  String   @default("external_search")
  dateKey   String   @map("date_key") // YYYY-MM-DD
  count     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, endpoint, dateKey])
  @@map("user_api_usages")
}

